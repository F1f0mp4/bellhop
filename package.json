{
  "name": "bellhop",
  "version": "1.0.0",
  "description": "Homelab request desk and media drop-off for Jellyfin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/src/index.ts",
    "test": "node --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
